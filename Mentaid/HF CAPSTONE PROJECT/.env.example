# API Keys for Enhanced GAIA Agent - Multi-LLM Strategy
# Copy this file to .env and fill in your actual API keys

# Primary LLM - Groq API Key (Ultra-fast reasoning, best for complex problems)
GROQ_API_KEY=your_groq_api_key_here

# Secondary LLM - Google Gemini API Key (Tool integration, multimodal)
GOOGLE_API_KEY=your_google_api_key_here

# Fallback LLM - HuggingFace API Token (Reliability backup)
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# Web Search - Tavily API Key (Enhanced search capabilities)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Space configuration for Hugging Face deployment
SPACE_ID=your_space_id_here
SPACE_HOST=your_space_host_here